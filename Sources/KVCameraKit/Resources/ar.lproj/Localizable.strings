/* KVCameraKit — the camera's own strings.
   Its own table because a package whose text resolves from the host bundle shows
   nothing but keys in any other project. */
"Camera access is required" = "مطلوب إذن الوصول إلى الكاميرا";
"Please enable camera access in Settings to take encrypted photos directly into your vault." = "يرجى تمكين الوصول إلى الكاميرا في الإعدادات لالتقاط صور مشفرة مباشرة في خزنتك.";
"Open Settings" = "افتح الإعدادات";
"Camera is unavailable" = "الكاميرا غير متوفرة";
"Another app or a phone call is using the camera." = "تطبيق آخر أو مكالمة هاتفية يستخدم الكاميرا.";
"PHOTO" = "صورة";
"VIDEO" = "فيديو";
"AE/AF LOCK" = "قفل AE/AF";
"Off" = "إيقاف";
"Photo could not be saved" = "تعذّر حفظ الصورة";
"Video could not be saved" = "تعذّر حفظ الفيديو";
"Close" = "إغلاق";
"Error" = "خطأ";
"SCAN" = "مسح";
"Position the document in frame" = "ضع المستند داخل الإطار";
"Could not read the document" = "لا يمكن قراءة المستند";

/* Filter names. Short by design: they sit on a chip in a strip across the
   bottom of the viewfinder, and a long one scrolls the strip. */
"Original" = "الأصلي";
"Vivid" = "زاهي";
"Warm" = "دافئ";
"Cool" = "بارد";
"Mono" = "أحادي";
